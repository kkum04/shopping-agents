# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=

# delivered example (examples/delivered): sign-in and the customer API default to staging
# (https://gw-staging.delivered.co.kr); set these to move them. The guest catalog stays on
# DELIVERED_API_URL (production by default).
DELIVERED_AUTH_URL=
DELIVERED_CUSTOMER_API_URL=
