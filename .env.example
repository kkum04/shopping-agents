# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=

# delivered example (examples/delivered): the guest catalog, sign-in, and the customer API all
# default to production (https://gw.delivered.co.kr). Set the three together to move to
# staging; a buy request names a product the customer API has to know.
DELIVERED_API_URL=
DELIVERED_AUTH_URL=
DELIVERED_CUSTOMER_API_URL=
